{
  "ConnectionStrings": {
    "CatalogDb": "Host=localhost;Port=5432;Database=catalog;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Catalog": {
    "Currency": "USD",
    "Cache": {
      "TimeToLive": "00:05:00"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
