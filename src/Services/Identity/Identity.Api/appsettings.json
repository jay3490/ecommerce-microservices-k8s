{
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=identity;Username=postgres;Password=postgres"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "ecommerce",
    "Password": "ecommerce"
  },
  "Identity": {
