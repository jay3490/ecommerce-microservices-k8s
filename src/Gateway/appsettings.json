{
  "Jwt": {
    "Issuer": "ecommerce-gateway",
    "Audience": "ecommerce-api",
    "EnableDevTokenEndpoint": false
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/products/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/products/{**rest}",
          "Methods": [ "POST", "PUT" ]
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/payments/{**rest}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101" }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102" }
        }
      },
      "inventory": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5103" }
        }
      },
      "payment": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5104" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
