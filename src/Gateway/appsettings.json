{
  "Jwt": {
    "Authority": "",
    "Issuer": "ecommerce-gateway",
    "Audience": "ecommerce-api",
    "EnableDevTokenEndpoint": false
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:00:10"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/products/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "catalog-write": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/products/{**rest}",
          "Methods": [ "POST", "PUT" ]
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/orders/{**rest}"
        }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/inventory/{**rest}"
        }
      },
      "payments": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/payments/{**rest}"
        }
      },
      "identity-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/identity/register",
          "Methods": [ "POST" ]
        }
      },
      "identity-token": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/identity/token/{**rest}",
          "Methods": [ "POST" ]
        }
      },
      "identity-account": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/identity/me",
          "Methods": [ "GET" ]
        }
      },
      "identity-admin": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/identity/users/{**rest}"
        }
      },
      "basket": {
        "ClusterId": "basket",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/basket/{**rest}"
        }
      },
      "shipments-read": {
        "ClusterId": "shipping",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/shipments/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "shipments-admin": {
        "ClusterId": "shipping",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/shipments/{**rest}",
          "Methods": [ "POST" ]
        }
      },
      "reviews-read": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/reviews/{**rest}",
          "Methods": [ "GET" ]
        }
      },
      "reviews-write": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "customer",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/reviews/{**rest}",
          "Methods": [ "PUT", "DELETE" ]
        }
      },
      "reviews-admin": {
        "ClusterId": "reviews",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/reviews/{**rest}",
          "Methods": [ "POST" ]
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101" }
        }
      },
      "ordering": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102" }
        }
      },
      "inventory": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5103" }
        }
      },
      "payment": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5104" }
        }
      },
      "identity": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5105" }
        }
      },
      "basket": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5106" }
        }
      },
      "shipping": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5107" }
        }
      },
      "reviews": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5108" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
